{
  "name": "vibereviewing",
  "version": "0.2.0",
  "description": "Split a GitHub PR into AI-reviewable layers",
  "license": "MIT",
  "author": "shoom3301 <shoom3301@gmail.com>",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/shoom3301/vibereviewing.git"
  },
  "bin": {
    "vibereviewing": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
