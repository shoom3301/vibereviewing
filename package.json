    "openai": "^4.80.0",
    "parse-diff": "^0.11.1",
    "picomatch": "^4.0.0",
    "tiktoken": "^1.0.0",
    "yaml": "^2.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/picomatch": "^3.0.0",
    "fast-check": "^4.8.0",
    "typescript": "^5.6.0",
